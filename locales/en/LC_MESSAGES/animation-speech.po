#, python-brace-format
msgid ""
"Your environment ({desktop}, {session}) does not support the Wayland Layer "
"Shell protocol (zwlr_layer_shell_v1).\n"
"\n"
"animation-speech requires this protocol to display a transparent overlay "
"above other windows.\n"
"\n"
"Compatible Wayland compositors:\n"
"  - KDE Plasma (KWin)\n"
"  - Sway\n"
"  - Hyprland\n"
"  - Wayfire\n"
"  - river, labwc, wlroots-based\n"
"\n"
"Wayland compositors without layer-shell support:\n"
"  - GNOME (Mutter) — uses a different protocol\n"
"  - Cinnamon (Muffin)\n"
"  - Budgie\n"
"  - COSMIC (not yet implemented)\n"
"  - Enlightenment\n"
"\n"
"X11 is not supported (Wayland required)."
msgstr ""

